# Base URL of the Keystone backend API. Copy to .env.local and adjust.
VITE_API_BASE_URL=http://localhost:8000

# Optional. Source repository; the header and footer link to it when set.
# VITE_REPO_URL=https://github.com/<owner>/<repo>

# Optional. Public URL of this frontend. When set, the build adds absolute
# og:image / og:url tags so links to the site unfurl with a preview image.
# VITE_PUBLIC_URL=https://keystone.example.com
